# Dev proxy manzili (vite.config.js). Brauzer kodiga tushmaydi.
BACKEND_URL=http://localhost:8000

# Bo'sh qoldirilsa so'rovlar shu domenga (/api/...) yuboriladi — proxy orqali.
# Production'da backend boshqa domenda bo'lsa yozing. API kalitni bu yerga QO'YMANG.
VITE_API_URL=

# Backendda UZEX_API_KEYS yoqilgan bo'lsa (masalan Render). Faqat dev-proxy ishlatadi, brauzerga tushmaydi.
# Production'da bu qiymat Netlify environment variables'ga qo'yiladi (README → Netlify'ga joylash).
UZEX_API_KEY=
